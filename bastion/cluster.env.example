# bastion/run.sh 설정 파일
# 사용법: 이 파일을 bastion/cluster.env 로 복사한 뒤 값을 채우고 실행
#   cp bastion/cluster.env.example bastion/cluster.env
#   bash bastion/run.sh

SSH_USER=clabi

# 공백으로 구분. 첫 번째 IP가 kubeadm init을 실행하는 CP1이 됨
CP_IPS="10.0.0.11 10.0.0.12 10.0.0.13"

# 공백으로 구분, 없으면 빈 문자열("")로 둘 것
# CP를 Worker로도 쓰려면 그 CP의 IP를 여기에도 똑같이 적기 (자동으로 taint 제거됨)
WORKER_IPS="10.0.0.21 10.0.0.22"

# CP_IPS가 2개 이상이면 필수 (keepalived VIP), 1개면 빈 문자열("")로 둘 것
VIP=""

# Pod network CIDR (Calico). 물리 네트워크와 겹치지 않으면 기본값(Calico 기본값) 그대로 둘 것
POD_CIDR="192.168.0.0/16"

# k8s 클러스터(00~05) 이후 CP1에 추가로 설치할 것들. 1=설치, 0=건너뜀
# INSTALL_MLFLOW=1이면 INSTALL_KUBEFLOW=1도 필요함 (MLflow가 Kubeflow의 SeaweedFS/대시보드를 재사용함)
INSTALL_GPU_OPERATOR=1
INSTALL_KUBEFLOW=1
INSTALL_MLFLOW=1

# CP_IPS/WORKER_IPS 중 실제 GPU가 있는 노드만 공백으로 구분해서 적기
# INSTALL_GPU_OPERATOR=1이면 필수 (드라이버를 호스트에 직접 설치하는 대상 노드)
GPU_IPS="10.0.0.21 10.0.0.22"
