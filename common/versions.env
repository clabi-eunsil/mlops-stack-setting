# 목표 버전 정의
# check_versions.sh가 이 파일을 source해서 실제 설치 상태와 비교함
# "x"로 끝나는 값은 major.minor까지만 맞으면 OK로 판정 (예: 1.36.x -> 1.36.4도 통과)

OS_VERSION=24.04
KERNEL_VERSION=6.8
K8S_VERSION=1.36.x
CONTAINERD_VERSION=2.2.x
CNI_CALICO_VERSION=3.32.x

GPU_OPERATOR_VERSION=26.7.0
GPU_DRIVER_VERSION=595.91.07
NVIDIA_CTK_VERSION=1.20.0
NVIDIA_DEVICE_PLUGIN_VERSION=0.20.0
NVIDIA_NFD_VERSION=0.19.0
NVIDIA_GFD_VERSION=0.20.0
DCGM_VERSION=4.6.0
DCGM_EXPORTER_VERSION=4.6.0

KUBEFLOW_PIPELINES_VERSION=2.16.0
KUBEFLOW_TRAINER_VERSION=2.1.0
TRAINING_OPERATOR_VERSION=1.9.2
KATIB_VERSION=0.19.0
KSERVE_VERSION=0.16.0
ISTIO_VERSION=1.29.0
CERT_MANAGER_VERSION=1.19.4
DEX_VERSION=2.45.0
OAUTH2_PROXY_VERSION=7.14.3
KNATIVE_VERSION=1.21.1
ARGO_WORKFLOWS_VERSION=3.7.3
KUSTOMIZE_VERSION=5.8.1

MLFLOW_VERSION=3.13.0
MYSQL_VERSION=8.4

# 런타임으로 조회 불가 (git clone 시 --branch로 고정하는 값이라 여기선 참고용)
# [Update] repo가 kubeflow/manifests -> kubeflow/community-distribution 으로 이름이 바뀜
# 태그가 아니라 release-<버전> 브랜치로 배포됨. 버전표(v1)와 정확히 일치하는 쪽은 release-26.03
# (release-26.03.1은 최신 패치지만 Istio/cert-manager/Dex 등 여러 버전이 더 올라가 있고
#  Model Registry -> Hub 개명 등 구조 변경도 섞여 있어 versions.env와 어긋남)
KUBEFLOW_DISTRIBUTION_REPO=kubeflow/community-distribution
KUBEFLOW_DISTRIBUTION_REF=release-26.03
